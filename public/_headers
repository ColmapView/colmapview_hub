/hub/*
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, nofollow, noarchive

/hub/datasets/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Cache-Control: public, no-cache, must-revalidate, no-transform
  Cloudflare-CDN-Cache-Control: no-store

/hub/datasets/*.manifest.json
  Access-Control-Allow-Origin: *

# Previews are public JPEGs named by their complete content hash.
/hub/datasets/individual/thumbnails/*
  ! Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

/hub/datasets/individual/manifests/*.state.json
  Access-Control-Allow-Origin: *

# Public frontend bundles and licensed fonts also serve the GitHub-hosted Hub.
/hub/assets/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, no-cache, must-revalidate

# The built homepage also has direct public asset URLs.
/hub/assets/catalog-home*.html
  ! Cache-Control
  Cache-Control: public, no-cache, must-revalidate, no-transform
  Cloudflare-CDN-Cache-Control: no-store
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'none'; script-src 'self' https://www.googletagmanager.com; style-src 'self'; img-src 'self' https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; frame-src https://colmapview.opsiclear.com https://colmapview.github.io; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

/hub/fonts/*
  Access-Control-Allow-Origin: *

/hub/styles.css
  Access-Control-Allow-Origin: *

/hub/colmapview.css
  Access-Control-Allow-Origin: *

# Exported templates and their dependencies are named by complete content hashes.
/hub/assets/github/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform

/hub/assets/github/site.json
  ! Cache-Control
  Cache-Control: public, no-cache, must-revalidate, no-transform
