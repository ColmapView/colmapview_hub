{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["./worker-configuration.d.ts", "node", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/worker", "src/shared", "tests", "vitest.config.ts", "worker-configuration.d.ts"]
}
