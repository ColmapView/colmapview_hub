{
  "name": "colmapview_hub",
  "version": "0.7.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:assets && node scripts/dev.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:assets": "npm run build:client && npm run build:catalog",
    "catalog:import": "node scripts/import-catalog.mjs",
    "catalog:licenses": "node scripts/license-categories.mjs",
    "test:catalog": "node --test tests/catalog.test.mjs tests/individual-catalog.test.mjs",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "check:css": "node scripts/check-colmapview-css.mjs",
    "test": "vitest run",
    "test:browser": "playwright test --workers=1",
    "build": "npm run build:assets && wrangler deploy --dry-run --outdir .tmp/build",
    "check": "npm run typecheck && npm run lint && npm run check:css && npm run test:catalog && npm test && npm run build",
    "deploy": "npm run build:assets && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.58.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
