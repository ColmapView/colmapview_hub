{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colmapview-hub",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "colmapview.opsiclear.com/hub",
      "zone_name": "opsiclear.com"
    },
    {
      "pattern": "colmapview.opsiclear.com/hub/*",
      "zone_name": "opsiclear.com"
    },
    {
      "pattern": "colmapview.opsiclear.com/s",
      "zone_name": "opsiclear.com"
    },
    {
      "pattern": "colmapview.opsiclear.com/s/*",
      "zone_name": "opsiclear.com"
    },
    {
      "pattern": "colmapview.opsiclear.com/auth/*",
      "zone_name": "opsiclear.com"
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "CATALOG_ASSETS",
    // Public export URLs are exact, content-hashed files; never canonicalize .html downloads.
    "html_handling": "none",
    // Static files in public/hub/ are served at /hub/… without the Worker. Wrangler's warning that the routes "will attempt
    // to serve Assets on a configured path" is expected for this /hub/* → public/hub/* mapping. Setting run_worker_first
    // back to true would route static files through the Worker again.
    "run_worker_first": ["/auth/*", "/s", "/s/*", "/hub", "/hub/*", "!/hub/assets/*", "!/hub/fonts/*", "!/hub/colmapview.css", "!/hub/styles.css", "!/hub/favicon.ico", "!/hub/datasets/individual/*", "!/hub/datasets/*.manifest.json", "!/hub/datasets/audit*", "!/hub/datasets/catalog*", "!/hub/datasets/dataset-audit.json"]
  },
  "d1_databases": [
    {
      "binding": "HUB_DB",
      "database_name": "colmapview-hub",
      "database_id": "2cf3f730-e26e-405e-9842-502ac73af761",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "HUB_PUBLICATION_READS",
      "namespace_id": "2026102001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOOKUP_GUARDS",
        "class_name": "LookupGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ClientGuard"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "LookupGuard"
      ],
      "deleted_classes": [
        "ClientGuard"
      ]
    },
    {
      "tag": "v3-account-sessions",
      "new_sqlite_classes": ["AccountSession"]
    },
    {
      "tag": "v4-remove-account-sessions",
      "deleted_classes": ["AccountSession"]
    }
  ],
  "vars": {
    "HUB_ORIGIN": "https://colmapview.opsiclear.com",
    "HUB_VIEWER_ORIGIN": "https://colmapview-opsiclear.pages.dev",
    "HUB_PATH": "/hub",
    "HUB_LISTINGS_ENABLED": "false",
    "HUB_PUBLICATIONS_ENABLED": "true",
    "HUB_TURNSTILE_SITE_KEY": "0x4AAAAAAFeSm6g2_ZlVUxgb"
  },
  "secrets": {
    "required": ["HUB_KEY"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "account_id": "c9cc8c86e445c959591ac1dd26ee0b17"
}
